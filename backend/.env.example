# --- Runtime ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Data residency (PDPP §1.7) ---
# DATABASE_URL must point at a Postgres instance physically located in Ethiopia.
DATABASE_URL=postgres://yet:change-me@localhost:5432/yet
REDIS_URL=redis://localhost:6379

# --- Identity & Access (Module 1) ---
JWT_SECRET=dev-only-secret-change-me-32-bytes!!
JWT_ACCESS_TTL=12h
ADMIN_BOOTSTRAP_EMAIL=admin@yet.local
ADMIN_BOOTSTRAP_PASSWORD=change-me

# --- OSM self-hosted stack (§1.6) ---
OSRM_BASE_URL=http://localhost:5000
NOMINATIM_BASE_URL=http://localhost:8081
# OSM usage policy: identify YET on any request reaching public OSM services (§1.6).
OSM_USER_AGENT=YET-tracking/0.1 (fleet-visibility; ops-contact@yet.local)

# --- Ingest guardrails (§1.10.4) ---
INGEST_RATE_LIMIT_PER_MIN=60
INGEST_MAX_BATCH_FIXES=100

# --- Trip Engine (Module 3, Phase 2) ---
# §1.3 GPS-off gate: stationary duration before STOPPED (seconds)
TRIP_STOPPED_AFTER_S=60
# §1.4 driver separation distance threshold (meters)
TRIP_SEPARATION_THRESHOLD_M=50
# §1.4 DRIVER_RETURNED hysteresis threshold (meters)
TRIP_RETURN_THRESHOLD_M=30
# Auto-END trip after this inter-fix gap (seconds)
TRIP_IDLE_TIMEOUT_S=1800
# §1.4 notify fleet manager after separation lasting this many minutes
TRIP_SEPARATION_NOTIFY_MIN=45

# --- Sensor-fusion classification thresholds (Phase 2, §1.3) ---
# Published to the driver app via GET /trips/classification-config; the device
# classifiers and the server-side raw-sample fallback both read these values —
# calibrated configuration, never magic numbers in code.
# Longitudinal deceleration peak that counts as harsh braking (m/s^2)
HARSH_BRAKE_THRESHOLD_MPS2=3.5
# Longitudinal acceleration peak that counts as harsh acceleration (m/s^2)
HARSH_ACCEL_THRESHOLD_MPS2=2.5
# Gyroscope |z| angular velocity for turn detection (deg/s) ...
TURN_RATE_THRESHOLD_DPS=35
# ... sustained for at least this long (§1.3: > 1 second), milliseconds
TURN_MIN_DURATION_MS=1000
# Accelerometer variance above which the vibration gate considers the truck moving
MOTION_VARIANCE_THRESHOLD=0.05

# --- Phase 5 (§1.10.6): data-retention downsampling job ---
# Raw location_fixes older than RETENTION_AGE_DAYS are downsampled to every
# RETENTION_KEEP_EVERY_N-th fix; trip aggregates and notification_log are kept
# indefinitely. Runner: backend/scripts/retention.mjs (npm run retention), the
# compose `retention` service (--profile maintenance), or POST
# /reports/retention/run on a NON-PRODUCTION server (ADMIN only).
# Nightly schedule lives in infra/cron/yet-retention (02:30 Africa/Addis_Ababa).
RETENTION_AGE_DAYS=90
RETENTION_KEEP_EVERY_N=10
# DRY_RUN=1 previews delete counts without deleting (shakedown first week).
DRY_RUN=0

# --- Phase 5 (§1.7): read replica for report/fleet-state reads ---
# Optional. When set, reporting endpoints route reads through db/replica.ts,
# which enforces WAL-catch-up + Ethiopian data-residency allowlist on the
# replica host before serving personal data. Empty = primary-only reads.
READER_DATABASE_URL=
