# --- Runtime ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Data residency (PDPP §1.7) ---
# DATABASE_URL must point at a Postgres instance physically located in Ethiopia.
DATABASE_URL=postgres://yet:change-me@localhost:5432/yet
REDIS_URL=redis://localhost:6379

# --- Identity & Access (Module 1) ---
JWT_SECRET=dev-only-secret-change-me-32-bytes!!
JWT_ACCESS_TTL=12h
ADMIN_BOOTSTRAP_EMAIL=admin@yet.local
ADMIN_BOOTSTRAP_PASSWORD=change-me

# --- OSM self-hosted stack (§1.6) ---
OSRM_BASE_URL=http://localhost:5000
NOMINATIM_BASE_URL=http://localhost:8081
# OSM usage policy: identify YET on any request reaching public OSM services (§1.6).
OSM_USER_AGENT=YET-tracking/0.1 (fleet-visibility; ops-contact@yet.local)

# --- Ingest guardrails (§1.10.4) ---
INGEST_RATE_LIMIT_PER_MIN=60
INGEST_MAX_BATCH_FIXES=100
