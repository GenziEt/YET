# Copy to .env and fill in. NEVER commit the real .env (contains personal-data credentials,
# PDPP §1.7). This file documents required configuration only.

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB=yet
POSTGRES_USER=yet
POSTGRES_PASSWORD=change-me-strong-random

# --- Identity / API ------------------------------------------------------------
JWT_SECRET=change-me-32bytes-random
JWT_ACCESS_TTL=12h
ADMIN_BOOTSTRAP_EMAIL=admin@yet.local
ADMIN_BOOTSTRAP_PASSWORD=change-me

# --- OSM extracts ---------------------------------------------------------------
OSM_EXTRACT=ethiopia-latest
OSRM_PROFILE=driving

# --- Rate limits (§1.10.4) -------------------------------------------------------
INGEST_RATE_LIMIT_PER_MIN=60

# --- PDPP compliance boot gates (backend/src/config/env.ts validateComplianceBoot) ---
# Hosting attestation: 2-letter country code where this stack physically runs.
# MUST be ET — production residency validation only accepts the private compose
# DB hostnames ("postgres") when HOSTING_COUNTRY=ET is attested (PDPP §1.7).
HOSTING_COUNTRY=ET

# ECA data-controller registration (PDPP §1.2). Production boots ONLY with a
# CONFIRMED registration (the field pilot requires confirmed status):
#   ECA_REGISTRATION_STATUS=completed   # not_started|in_progress|submitted|completed
#   ECA_REGISTRATION_NUMBER=ECA-XXXXXXX # authority-assigned reference (>=5 chars)
ECA_REGISTRATION_STATUS=not_started
ECA_REGISTRATION_NUMBER=

# Active processors must each carry a signed DPA reference (PDPP §1.7), e.g.:
#   PROCESSORS_ACTIVE=HOSTING_PARTNER,SMS_GATEWAY,FCM_PUSH
#   DPA_HOSTING_PARTNER_REFERENCE=DPA-2026-001
PROCESSORS_ACTIVE=
BREACH_NOTIFICATION_CONTACT=compliance@yet.local

# OTP_DEV_ECHO must remain false in production (auth bypass gate refuses boot).
OTP_DEV_ECHO=false
