# Copy to .env and fill in. NEVER commit the real .env (contains personal-data credentials,
# PDPP §1.7). This file documents required configuration only.

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB=yet
POSTGRES_USER=yet
POSTGRES_PASSWORD=change-me-strong-random

# --- Identity / API ------------------------------------------------------------
JWT_SECRET=change-me-32bytes-random
JWT_ACCESS_TTL=12h
ADMIN_BOOTSTRAP_EMAIL=admin@yet.local
ADMIN_BOOTSTRAP_PASSWORD=change-me

# --- OSM extracts ---------------------------------------------------------------
OSM_EXTRACT=ethiopia-latest
OSRM_PROFILE=driving

# --- Rate limits (§1.10.4) -------------------------------------------------------
INGEST_RATE_LIMIT_PER_MIN=60
