{
  "@@locale": "en",
  "appTitle": "YET Driver",
  "consentTitle": "Location & motion data consent",
  "consentBody": "YET tracks your phone's location and motion so your fleet manager can see where the shipment is. This phone is the only tracker — when you walk away with it, the truck's live position stops updating.",
  "consentCollectHeading": "What we collect",
  "consentCollectBody": "GPS location during trips, movement sensor data (accelerometer/gyroscope). Audio is NEVER collected unless you turn on 'Improve motion detection' below.",
  "consentWhoHeading": "Who sees it",
  "consentWhoBody": "Only your assigned fleet manager. Data is stored on servers inside Ethiopia under Ethiopian law (Proclamation No. 1321/2024).",
  "consentRetentionHeading": "How long we keep it",
  "consentRetentionBody": "Detailed location history for 90 days, then reduced to trip summaries. You can request deletion at any time; we complete it within 30 days.",
  "consentImproveMotion": "Improve motion detection (optional microphone sampling, 1–2 seconds)",
  "consentAgree": "I agree — start using YET",
  "consentDecline": "Do not agree",
  "consentDeclinedBody": "Without consent YET cannot collect any data and will not run. You may change this decision later in Settings.",
  "permTitle": "Permissions needed",
  "permLocationBody": "YET needs location access 'All the time' because tracking must continue while the app is closed and you are driving.",
  "permBatteryBody": "Please allow YET to ignore battery optimization. Android would otherwise stop tracking after a few minutes and your trip data would be lost.",
